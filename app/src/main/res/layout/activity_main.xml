<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <!-- App Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🤖 Binance Automated Trading Bot"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        android:gravity="center"
        android:paddingBottom="20dp" />

    <!-- Status Card / View -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Connected &amp; Monitoring"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Symbol Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trading Symbol (e.g., BTCUSDT)"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etSymbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BTCUSDT"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#2C2C2C"
        android:padding="12dp"
        android:layout_marginBottom="15dp" />

    <!-- Direction Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Direction (LONG / SHORT)"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etDirection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LONG"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#2C2C2C"
        android:padding="12dp"
        android:layout_marginBottom="15dp" />

    <!-- Margin Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initial Margin (USDT)"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10.0"
        android:inputType="numberDecimal"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#2C2C2C"
        android:padding="12dp"
        android:layout_marginBottom="25dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnSubmitEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Trading Cycle"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00E676"
        android:textColor="#000000"
        android:padding="12dp" />

</LinearLayout>
